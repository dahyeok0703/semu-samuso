# ============================================================================
# Environment variables (copy to .env.local and fill in)
#
# Validated at boot by src/lib/env.ts (zod). Missing/invalid REQUIRED vars
# crash the app with a clear message. OPTIONAL vars gracefully disable the
# related feature when absent (see `features` in src/lib/env.ts).
# ============================================================================

# --- Supabase (REQUIRED) ----------------------------------------------------
# Local dev: get these from `supabase start` output, or Supabase dashboard
# (Project Settings → API) for a hosted project.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase service role (OPTIONAL, server-only) --------------------------
# Privileged key for admin/maintenance scripts. NEVER expose to the browser.
# Leave blank to keep service-role features disabled.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Claude API (OPTIONAL, server-only) -------------------------------------
# Document auto-classification. Without it, auto-classification is disabled and
# the app falls back to manual classification (everything else works).
ANTHROPIC_API_KEY=""
# Per-workspace daily auto-classification call cap (cost guard). Default 500.
AI_DAILY_CLASSIFY_LIMIT="500"

# --- Outbound email for reminders (OPTIONAL) --------------------------------
# App's own messages (독촉/알림). Without SMTP, the email channel logs instead
# of sending (dev/demo). This is separate from Supabase's auth-email SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="세무사무소 <noreply@office.example>"

# --- Solapi: KakaoTalk 알림톡 / SMS (OPTIONAL) ------------------------------
# Missing → kakao/sms channels disabled and auto-fall back to email.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""              # registered sender phone number
SOLAPI_PFID=""                # KakaoTalk channel (plus friend) id
SOLAPI_KAKAO_TEMPLATE_ID=""   # 알림톡 template id for the docs-reminder message
SOLAPI_WEBHOOK_SECRET=""      # 발송 결과 콜백(/api/webhooks/solapi) 서명 검증

# --- CODEF: 은행/카드 거래내역 수집 (OPTIONAL) ------------------------------
# Missing → CODEF 연동 비활성. 워크스페이스 설정(관리자)에서도 키 입력 가능.
CODEF_CLIENT_ID=""
CODEF_CLIENT_SECRET=""
CODEF_PUBLIC_KEY=""

# 참고: 위 SOLAPI/CODEF 키는 워크스페이스별로 관리자 설정 화면에서도 입력할 수 있으며,
# env(글로벌)과 병합됩니다. ERP 가져오기(더존/세무사랑)는 키가 필요 없습니다.

# --- Cron (OPTIONAL) ---------------------------------------------------------
# Shared secret protecting GET /api/cron/* (reminders, billing, margin,
# ai-batch). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Required in production.
CRON_SECRET=""

# --- Internal superusers (OPTIONAL) -----------------------------------------
# Comma-separated emails that may view the cross-workspace margin monitor on
# /admin (MRR vs COGS, 마진 < 목표치 자동 플래그). Empty → nobody sees it.
SUPERUSER_EMAILS=""

# --- Error monitoring (OPTIONAL) --------------------------------------------
# Sentry DSN. Without it, error reporting is a no-op (structured logs only).
# Activating also requires installing @sentry/nextjs (optional dependency).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Rate limiting (OPTIONAL) -----------------------------------------------
# Set to "true" only to disable rate limiting (e.g. local load tests).
RATE_LIMIT_DISABLED=""

# --- PortOne v2 billing / 정기결제 (OPTIONAL) --------------------------------
# Subscription billing via PortOne v2 billing keys (TossPayments PG). Without
# these the billing UI shows "준비중" and subscriptions are disabled — the rest
# of the app works normally (dev/internal launch OK).
#   • PORTONE_API_SECRET           : V2 API secret (server-only)
#   • PORTONE_WEBHOOK_SECRET       : Standard Webhooks signing secret (whsec_...)
#   • NEXT_PUBLIC_PORTONE_STORE_ID : store-... (browser SDK)
#   • NEXT_PUBLIC_PORTONE_CHANNEL_KEY : TossPayments billing channel key
# Billing also requires SUPABASE_SERVICE_ROLE_KEY (the billing key is stored in
# a service-role-only table). See docs/billing-test-flow.md.
PORTONE_API_SECRET=""
PORTONE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=""

# --- Site URL (OPTIONAL) -----------------------------------------------------
# Public origin used to build auth redirect / email callback links.
# Falls back to the request host when unset. Set explicitly in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Demo mode (OPTIONAL) ----------------------------------------------------
# "true" 로 두면 Supabase 키가 없어도 프로덕션 빌드/배포가 크래시하지 않고 공개
# 화면만 데모 placeholder 로 렌더됩니다(Vercel 키리스 데모용). 실서비스에선 설정하지 마세요.
NEXT_PUBLIC_DEMO_MODE=""
