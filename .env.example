# ============================================================================
# Environment variables (copy to .env.local and fill in)
#
# Validated at boot by src/lib/env.ts (zod). Missing/invalid REQUIRED vars
# crash the app with a clear message. OPTIONAL vars gracefully disable the
# related feature when absent (see `features` in src/lib/env.ts).
# ============================================================================

# --- Supabase (REQUIRED) ----------------------------------------------------
# Local dev: get these from `supabase start` output, or Supabase dashboard
# (Project Settings → API) for a hosted project.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase service role (OPTIONAL, server-only) --------------------------
# Privileged key for admin/maintenance scripts. NEVER expose to the browser.
# Leave blank to keep service-role features disabled.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Site URL (OPTIONAL) -----------------------------------------------------
# Public origin used to build auth redirect / email callback links.
# Falls back to the request host when unset. Set explicitly in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
